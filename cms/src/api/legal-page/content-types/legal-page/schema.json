{
  "kind": "collectionType",
  "collectionName": "legal_pages",
  "info": {
    "singularName": "legal-page",
    "pluralName": "legal-pages",
    "displayName": "Legal Page",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "breadcrumbs": { "type": "component", "component": "shared.link-item", "repeatable": true },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "mobileImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "topLevelImages": { "type": "media", "multiple": true, "allowedTypes": ["images"] },
    "getQuoteButtonText": { "type": "string" },
    "quickLinks": { "type": "component", "component": "blocks.quick-links", "repeatable": false },
    "contentBlocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.content-section",
        "blocks.banner",
        "blocks.quick-links",
        "blocks.accordion",
        "blocks.faqs",
        "blocks.video-section",
        "blocks.scripts"
      ]
    },
    "seo": { "type": "component", "component": "shared.seo", "repeatable": false }
  }
}
