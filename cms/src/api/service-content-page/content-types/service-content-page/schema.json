{
  "kind": "collectionType",
  "collectionName": "service_content_pages",
  "info": {
    "singularName": "service-content-page",
    "pluralName": "service-content-pages",
    "displayName": "Service Content Page",
    "description": "Individual SEO content/knowledge-base pages at /:categorySlug/:contentSlug"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "richtext"
    },
    "content": {
      "type": "richtext"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-content-category.service-content-category",
      "inversedBy": "contentPages"
    },
    "tags": {
      "type": "json"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "showInMenu": {
      "type": "boolean",
      "default": false
    },
    "menuOrder": {
      "type": "integer",
      "default": 0
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "breadcrumbs": { "type": "component", "component": "shared.link-item", "repeatable": true },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "mobileImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "topLevelImages": { "type": "media", "multiple": true, "allowedTypes": ["images"] },
    "getQuoteButtonText": { "type": "string" },
    "quickLinks": { "type": "component", "component": "blocks.quick-links", "repeatable": false },
    "contentBlocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.content-section",
        "blocks.banner",
        "blocks.quick-links",
        "blocks.accordion",
        "blocks.faqs",
        "blocks.video-section",
        "blocks.scripts"
      ]
    }
  }
}
