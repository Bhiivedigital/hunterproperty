{
  "kind": "collectionType",
  "collectionName": "service_content_pages",
  "info": {
    "singularName": "service-content-page",
    "pluralName": "service-content-pages",
    "displayName": "Service Content Page",
    "description": "Individual SEO content/knowledge-base pages at /:categorySlug/:contentSlug"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "text"
    },
    "coverImage": {
      "type": "string"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-content-category.service-content-category",
      "inversedBy": "contentPages"
    },
    "tags": {
      "type": "json"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "showInMenu": {
      "type": "boolean",
      "default": false
    },
    "menuOrder": {
      "type": "integer",
      "default": 0
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
